# ---------------------------------------------------------------------------
# .env.example — LLM Reliability & Experimentation Platform
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values you actually have:
#
#   cp .env.example .env
#
# All provider credentials below are OPTIONAL — the platform only needs a
# key for the providers you intend to benchmark/evaluate against. Ollama
# needs no key at all since it runs as a local/host server.
#
# `.env` is loaded automatically by docker-compose (see `env_file:` in
# docker-compose.yml) AND, outside Docker, by core/config.py itself via
# `load_dotenv(override=False)` — so this same file works whether you run
# the app in a container or directly with `streamlit run`.
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# Provider API keys (all optional — leave blank to skip that provider)
# ---------------------------------------------------------------------------

# OpenAI — used by providers/openai_provider.py
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic (Claude) — used by providers/anthropic_provider.py
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Google Gemini — read directly by core/config.py as `Settings.gemini_api_key`
# (validation_alias="GEMINI_API_KEY"), stored as a SecretStr.
GEMINI_API_KEY=your-gemini-key-here

# Ollama does not require an API key — it's a local/host inference server.
# Instead, point the app at wherever Ollama is running. When running via
# docker-compose, the app container reaches the HOST machine's Ollama
# instance through `host.docker.internal` (see docker-compose.yml comments).
# When running the app directly on the host (no Docker), use localhost.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_BASE_URL=http://localhost:11434   # <- use this when NOT in Docker


# ---------------------------------------------------------------------------
# Optional: LLM_PLATFORM__ nested config overrides
# ---------------------------------------------------------------------------
# core/config.py's Settings model reads any env var prefixed with
# `LLM_PLATFORM__` (double underscore separates nested keys) and lets it
# override the matching value from configs/default.yaml. Uncomment and
# edit any of these as needed — everything below is optional and already
# has a sane default in configs/default.yaml / the Pydantic models.
#
# App metadata (AppConfig)
# LLM_PLATFORM__APP__NAME=LLM Reliability Platform
# LLM_PLATFORM__APP__DEBUG=false
# LLM_PLATFORM__APP__ENVIRONMENT=production
#
# Database (DatabaseConfig) — SQLite file lives under the ./data volume
# LLM_PLATFORM__DATABASE__URL=sqlite:///./data/platform.db
# LLM_PLATFORM__DATABASE__ECHO=false
#
# MLflow (MLflowConfig) — tracking data lives under the ./mlruns volume
# LLM_PLATFORM__MLFLOW__TRACKING_URI=./mlruns
# LLM_PLATFORM__MLFLOW__EXPERIMENT_NAME=llm-reliability
# LLM_PLATFORM__MLFLOW__ARTIFACT_LOCATION=./mlartifacts
#
# Logging (LoggingConfig)
# LLM_PLATFORM__LOGGING__LEVEL=INFO
# LLM_PLATFORM__LOGGING__LOG_DIR=./logs
#
# Provider client defaults (ProvidersConfig) — shared across all providers
# LLM_PLATFORM__PROVIDERS__TIMEOUT_SECONDS=30
# LLM_PLATFORM__PROVIDERS__MAX_RETRIES=3
# LLM_PLATFORM__PROVIDERS__RETRY_BACKOFF_FACTOR=2.0
#
# Benchmarks (BenchmarksConfig)
# LLM_PLATFORM__BENCHMARKS__DEFAULT_RUNS=5
# LLM_PLATFORM__BENCHMARKS__CONCURRENCY=4
#
# Evaluation thresholds (EvaluationConfig)
# LLM_PLATFORM__EVALUATION__LATENCY_THRESHOLD_MS=5000
# LLM_PLATFORM__EVALUATION__ERROR_RATE_THRESHOLD=0.05
#
# Dashboard (DashboardConfig)
# LLM_PLATFORM__DASHBOARD__PAGE_TITLE=LLM Reliability Platform
# LLM_PLATFORM__DASHBOARD__LAYOUT=wide